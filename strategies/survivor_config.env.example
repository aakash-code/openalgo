# OpenAlgo Survivor Strategy Configuration
# Copy this file to survivor_config.env and update with your values

# OpenAlgo API Configuration
OPENALGO_API_KEY=your-openalgo-api-key-here
OPENALGO_HOST=http://127.0.0.1:5000
OPENALGO_WS_URL=ws://127.0.0.1:8765

# Strategy Parameters
SYMBOL_INITIALS=NIFTY25JAN30
PE_GAP=25
CE_GAP=25
PE_QUANTITY=50
CE_QUANTITY=50
MIN_PRICE_TO_SELL=15.0

# Risk Management
MAX_LOSS_PER_LOT=100.0
TARGET_PROFIT_PER_LOT=50.0

# Logging
LOG_LEVEL=INFO

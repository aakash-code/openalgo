def now_ist() -> datetime:
    """IST wall-clock time, independent of the host machine's configured
    timezone. datetime.now() silently returns whatever local tz the OS is set
    to — UTC by default on most cloud VMs — which would shift every session
    window, date rollover, and time-exit check by 5.5 hours. utcnow() is not
    subject to that: it reflects true UTC regardless of the host's tz label,
    so adding the fixed IST offset here is correct no matter how the server
    is configured."""
    return datetime.now(timezone.utc).replace(tzinfo=None) + timedelta(hours=5, minutes=30)


